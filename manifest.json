{
  "name": "Hızlı Okuma",
  "short_name": "Hızlı Okuma",
  "description": "EPUB kitapları kelime kelime, göz hareketi olmadan (RSVP) okuma uygulaması",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#121316",
  "theme_color": "#121316",
  "lang": "tr",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./paylas",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "kitap", "accept": [".epub", "application/epub+zip"] }] }
  }
}
